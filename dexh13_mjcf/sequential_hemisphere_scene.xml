<?xml version="1.0" encoding="utf-8"?>
<mujoco model="dexh13_sequential_hemisphere">
  <!-- The complete dual-arm model remains the source of truth for robot joints,
       meshes, tactile geoms, and the 2,280 touch sensors. -->
  <include file="dual_diana7_dexh13.xml" />

  <!-- SI units: metres, kilograms, seconds.  The experiment datum is on the
       white centre platform directly in front of the robot torso. -->
  <asset>
    <texture name="seq_floor_texture" type="2d" builtin="checker"
             rgb1="0.28 0.32 0.38" rgb2="0.18 0.21 0.26"
             width="512" height="512" mark="edge" markrgb="0.50 0.55 0.62" />
    <material name="seq_floor_material" texture="seq_floor_texture"
              texuniform="true" texrepeat="8 8" reflectance="0.08"
              rgba="0.50 0.56 0.64 1" />
  </asset>

  <worldbody>
    <!-- A 0.8 m square operating platform. x=0.347 follows the visual centre
         of the base_link mesh; y=-0.40 is the forward datum in this model. -->
    <geom name="operation_floor" type="plane" size="2 2 0.01"
          pos="0.347 -0.40 0" material="seq_floor_material"
          contype="2" conaffinity="0" />
    <geom name="operation_platform" type="box" size="0.40 0.40 0.025"
          pos="0.347 -0.40 0.025" rgba="0.78 0.80 0.84 1"
          contype="2" conaffinity="0" />

    <!-- Cylinder: diameter 100 mm, length 200 mm, standing on the platform. -->
    <body name="experiment_cylinder" pos="0.347 -0.40 0.15">
      <geom name="experiment_cylinder_geom" type="cylinder" size="0.05 0.10"
            rgba="0.12 0.48 0.82 1" friction="0.9 0.03 0.002"
            solref="0.015 1" solimp="0.92 0.98 0.002"
            contype="2" conaffinity="0" />
      <!-- A sphere centred on the cylinder top makes its lower half internal;
           the exposed upper half is the requested R=20 mm hemisphere. -->
      <geom name="experiment_hemisphere_geom" type="sphere" size="0.020"
            pos="0 0 0.10" rgba="0.95 0.56 0.10 1"
            friction="0.9 0.03 0.002"
            solref="0.015 1" solimp="0.92 0.98 0.002"
            contype="1" conaffinity="1" />
    </body>
  </worldbody>

  <visual>
    <global azimuth="120" elevation="-25" />
    <headlight diffuse="0.70 0.72 0.78" ambient="0.30 0.32 0.38" specular="0.18 0.18 0.20" />
  </visual>
</mujoco>
